{
  "openapi": "3.0.3",
  "info": {
    "title": "GO MO Group Public API",
    "version": "1.3.0",
    "description": "Public, read-only JSON API for GO MO Group (gomogroup.com) — the B2B digital marketing, GEO and Generative AI agency — plus one consent-gated contact action. Bilingual (English + Swedish). No authentication. Companion resources: agent page https://www.gomogroup.com/agent/, llms.txt https://www.gomogroup.com/llms.txt, MCP server https://www.gomogroup.com/mcp.",
    "contact": {
      "name": "GO MO Group",
      "email": "hello@gomogroup.com",
      "url": "https://www.gomogroup.com/en/contact-us/"
    },
    "license": {
      "name": "Content © GO MO Group AB — citation required"
    }
  },
  "servers": [
    {
      "url": "https://www.gomogroup.com/agent/v1",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "Discovery"
    },
    {
      "name": "Company"
    },
    {
      "name": "Services"
    },
    {
      "name": "Case studies"
    },
    {
      "name": "Insights"
    },
    {
      "name": "Actions"
    }
  ],
