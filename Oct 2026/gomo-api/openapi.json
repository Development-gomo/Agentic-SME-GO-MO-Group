    "/contact.json": {
      "post": {
        "operationId": "submitContactInquiry",
        "tags": [
          "Actions"
        ],
        "summary": "Submit a qualified B2B inquiry (consent-gated)",
        "description": "Delivers an inquiry to GO MO Group's commercial team. Agents must only call this after the human user explicitly asked to contact GO MO Group and approved the details; agent_context.user_authorized_submission must be true or the request is rejected with 403. Maximum body size 32768 bytes. Defaults: 5 attempts per client per hour and 20 site-wide; failed delivery attempts consume quota. Identical inquiries are reserved for 24 hours; an uncertain delivery remains pending to prevent duplicate mail.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Duplicate inquiry already received",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactResponse"
                }
              }
            }
          },
          "201": {
            "description": "Inquiry delivered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Consent flag missing or not true",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "An identical submission is already being processed; do not resubmit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds 32768 bytes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Delivery failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Contact disabled, reservation unavailable, or delivery outcome uncertain.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Meta": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "format": "uri"
          },
          "endpoint": {
            "type": "string"
          },
          "canonical": {
            "type": "string",
            "format": "uri"
          },
          "api": {
            "type": "string",
            "format": "uri"
          },
          "generated": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "string",
            "example": "1.3.0"
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "en",
                "sv"
              ]
            }
          },
          "license": {
            "type": "string"
          },
          "filters": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "per_page": {
            "type": "integer"
          },
          "pages": {
            "type": "integer"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "status",
          "error",
          "message"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "PricingTier": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "price_from": {
            "type": "number",
            "nullable": true
          },
          "includes": {
            "type": "string"
          }
        }
      },
      "Pricing": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "published",
              "quote-based"
            ]
          },
          "currency": {
            "type": "string",
            "nullable": true
          },
          "tiers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PricingTier"
            }
          }
        }
      },
      "Result": {
        "type": "object",
        "properties": {
          "metric": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "context": {
            "type": "string",
            "nullable": true
          },
          "period": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Service": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "summary",
          "languages"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "geo"
          },
          "name": {
            "type": "string"
          },
          "name_sv": {
            "type": "string",
            "nullable": true
          },
          "category": {
            "type": "string",
            "enum": [
              "search",
              "ai",
              "paid",
              "content",
              "outbound",
              "web",
              "strategy",
              "local"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string"
          },
          "summary_sv": {
            "type": "string",
            "nullable": true
          },
          "key_points": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pricing": {
            "$ref": "#/components/schemas/Pricing"
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "enterprise",
                "saas-tech",
                "sme"
              ]
            }
          },
          "related_cases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "url": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "url_sv": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "en",
                "sv"
              ]
            }
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dateModified": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "CaseStudy": {
        "type": "object",
        "required": [
          "id",
          "client",
          "headline",
          "languages"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "client": {
            "type": "string"
          },
          "headline": {
            "type": "string"
          },
          "headline_sv": {
            "type": "string",
            "nullable": true
          },
          "industry": {
            "type": "string"
          },
          "segment": {
            "type": "string",
            "nullable": true,
            "enum": [
              "enterprise",
              "saas-tech",
              "sme",
              null
            ]
          },
          "services": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "challenge": {
            "type": "string"
          },
          "solution": {
            "type": "string"
          },
          "summary_sv": {
            "type": "string",
            "nullable": true
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Result"
            }
          },
          "quote": {
            "type": "object",
            "nullable": true,
            "properties": {
              "text": {
                "type": "string"
              },
              "author": {
                "type": "string"
              },
              "role": {
                "type": "string"
              }
            }
          },
          "url": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "url_sv": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "en",
                "sv"
              ]
            }
          },
          "datePublished": {
            "type": "string",
            "format": "date"
          },
          "dateModified": {
            "type": "string",
